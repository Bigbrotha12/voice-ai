{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "voicebox": {
      "type": "remote",
      "url": "http://127.0.0.1:17600/mcp/",
      "headers": {
        "X-Voicebox-Client-Id": "opencode"
      },
      "enabled": true
    },
    "voice-agent": {
      "type": "local",
      "command": [
        "/home/bigbrotha/.local/bin/uv",
        "run",
        "--env-file",
        "/home/bigbrotha/Projects/ai/voicebox/.env",
        "--directory",
        "/home/bigbrotha/Projects/ai/voicebox/services/voice-mcp",
        "voice-mcp"
      ],
      "enabled": true
    }
  }
}

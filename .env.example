# Copy to .env and adjust. The wrapper reads these via environment variables;
# `uv run --env-file .env ...` loads them.

# Base URL of the Voicebox backend.
#   Podman/Docker container (primary path): http://127.0.0.1:17600
#   Source/desktop build:                   http://127.0.0.1:17493
VOICEBOX_URL=http://127.0.0.1:17600

# Identifier shown in Voicebox -> Settings -> MCP for this client.
# Also used as X-Voicebox-Client-Id on REST calls.
VOICEBOX_CLIENT_ID=voice-mcp

# Optional default voice profile name when callers omit `profile`.
# Falls back to whatever the user set as global default in Voicebox.
DEFAULT_PROFILE=

# say(): max seconds to watch the SSE status stream before giving up.
# Note: long texts go through chunking and can exceed this on slow engines.
SAY_TIMEOUT_SECONDS=120

# Where generated wavs land (container bind mount) - used by say() playback
# and scripts/play-latest.sh.
VOICEBOX_OUTPUT_DIR=~/Projects/ai/voicebox-upstream/output

# Host-side player for say(): auto (paplay -> ffplay -> mpv), none,
# or an explicit name from that list.
VOICEBOX_PLAYER=auto

# Silence (ms) pushed through the player before real audio, so idle-sink
# wake-up latency doesn't clip the start of speech. 0 disables.
VOICEBOX_WARMUP_MS=250

# Microphone source for listen(); overrides auto-detection
# (pactl get-default-source). Example: alsa_output.usb-headset.mono-fb
#VOICEBOX_MIC_DEVICE=

# ─── Telephony agent (telephony/pipecat-bot) ──────────────────────────────

# Voice profile UUID for the Pipecat bot's TTS. Required for `uv run voicebot`.
# List IDs with the voicebox MCP voices tool or GET /profiles.
VOICEBOX_PROFILE_ID=

# TTS engine (kokoro recommended for live turns; see telephony/RESEARCH.md).
VOICEBOX_ENGINE=kokoro

# STT provider for the bot: local (faster-whisper in-process, lowest latency,
# default) or voicebox (batch POST /transcribe - no extra VRAM, slower turns).
VOICEBOT_STT_PROVIDER=local

# Local provider (pipecat WhisperSTTService / CTranslate2). GPU needs the
# [gpu] uv extra (nvidia cublas/cudnn wheels); WHISPER_DEVICE=auto picks CUDA
# when available.
WHISPER_MODEL=deepdml/faster-whisper-large-v3-turbo-ct2
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=default

# Voicebox provider only: upstream whisper model name.
# IMPORTANT: use `base` when the runtime runs `--cpu` - small/turbo crash on
# CPU upstream (AGENTS.md).
VOICEBOX_STT_MODEL=turbo

# LiveKit dev server. These are the HOST-facing values, used when the bot
# runs on the host (`uv run voicebot`) or by test-client.html. When the bot
# runs inside the bundled stack (scripts/stack-up.sh), docker/voicebot.yml
# overrides them with internal service names (ws://livekit:7880).
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_ROOM=voicebot-room

# LLM endpoint for the Pipecat bot: the queues proxy (OpenAI-compatible HTTP
# facade over RabbitMQ; worker owns llama container lifecycle and model
# swapping). Port 9090 -> model.14b, 9091 -> model.3b (default), 9092 ->
# coder. Host-native homelab stack, NOT part of the container stack; the
# bundled bot reaches it via host.containers.internal.
# NOTE: cold starts after idle are real - first token can take ~30s while
# the worker reloads a model.
OLLAMA_MODEL=Qwen3-8B-Q4_K_M.gguf
OLLAMA_BASE_URL=http://localhost:9091/v1

# ─── Tools / MCP ───────────────────────────────────────────────────────────

# Streamable-HTTP MCP endpoints whose tools the LLM may call. Comma-separated.
# Expose our wrapper over HTTP host-side (bind 0.0.0.0 so podman containers
# reach it; endpoint has NO auth - loopback-only would block container access):
#   VOICE_MCP_TRANSPORT=http VOICE_MCP_HOST=0.0.0.0 uv run --directory services/voice-mcp voice-mcp
VOICEBOT_MCP_URLS=

# Wrapper HTTP transport knobs (defaults: stdio transport, 127.0.0.1:17601)
#VOICE_MCP_TRANSPORT=stdio
#VOICE_MCP_HOST=127.0.0.1
#VOICE_MCP_PORT=17601
